# Copie para .env (o instalar.sh faz isso e gera as senhas sozinho)

# Chave da Evolution API (gerada automaticamente)
AUTHENTICATION_API_KEY=troque-por-uma-chave-aleatoria
# Senha do banco (gerada automaticamente)
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
# Senha da página do QR Code (gerada automaticamente)
PAINEL_TOKEN=troque-por-um-token

# ---- Personalize ----
INSTANCIA=felipe
PIX_CHAVE=SUA-CHAVE-PIX-AQUI
SITE=https://felipepersonal.com
# Número que recebe aviso de novo lead/comprovante (opcional, ex.: 5521999999999). Vazio = sem aviso.
NOTIFICAR_NUMERO=
# Horas que o robô fica calado num contato depois que você responde manualmente
PAUSA_HUMANO_HORAS=12
# Depois de quantas horas sem conversa o robô manda as boas-vindas de novo
REINICIO_HORAS=24
